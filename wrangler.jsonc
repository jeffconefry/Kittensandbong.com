// Committed on purpose (playbook audit T4): pins the Worker name, compatibility date and bindings.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kittensandbongs-com",
  // Custom entry: Astro's fetch handler + the hourly cron job (src/worker.ts).
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Runs every hour at :07. The job itself decides whether it's time to publish
  // (SEND_HOUR in America/New_York), so DST needs no cron changes and a failed
  // send simply resumes on the next run.
  "triggers": { "crons": ["7 * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kittensandbongs",
      "database_id": "758f19f0-e023-48c6-800e-34d1f314f9fb",
      "migrations_dir": "migrations"
    }
  ],

  // Non-secret settings. Secrets (PEXELS_API_KEY, EMAIL_API_KEY, TURNSTILE_SECRET_KEY,
  // ADMIN_TOKEN) go in the dashboard as type Secret, or .dev.vars locally.
  "vars": {
    "SITE_URL": "https://kittensandbongs.com",
    "SEND_HOUR": "7",
    "EMAIL_PROVIDER": "log",
    "EMAIL_FROM": "Kittens and Bongs <daily@kittensandbongs.com>",
    "POSTAL_ADDRESS": ""
  }
}
