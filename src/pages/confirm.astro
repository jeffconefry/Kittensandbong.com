---
import Base from '../layouts/Base.astro';
import { TOKEN_RE } from '../lib/links';

const token = Astro.url.searchParams.get('t') ?? '';
const valid = TOKEN_RE.test(token) && !Astro.url.searchParams.has('error');
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---

<Base title="Confirm · Kittens & Bongs">
  <section class="message">
    {
      valid ? (
        <>
          <h1>Last step.</h1>
          <p>Confirm and you’ll get one kitten and one bong every morning.</p>
          <form method="post" action="/api/confirm">
            <input type="hidden" name="t" value={token} />
            <button class="btn" type="submit">Confirm my subscription</button>
          </form>
        </>
      ) : (
        <>
          <h1>That link didn’t work.</h1>
          <p>
            It may be old or already replaced by a newer one. <a href="/#signup">Sign up again</a> and we’ll send a fresh
            link.
          </p>
        </>
      )
    }
  </section>
</Base>
