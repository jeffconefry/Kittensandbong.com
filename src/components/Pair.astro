---
import type { DayPair, Photo } from '../lib/db';
import { longDate } from '../lib/day';

interface Props {
  pair: DayPair;
  heading?: string;
  today?: boolean;
}
const { pair, heading, today = false } = Astro.props;
const prefix = today ? 'Today’s' : 'The';

// No inline style attributes: the CSP hashes inline <style>/<script> blocks,
// and hashed policies block style="" attributes.
const cards: { label: string; photo: Photo }[] = [
  { label: `${prefix} kitten`, photo: pair.cat },
  { label: `${prefix} bong`, photo: pair.bong },
];
---

<section class="pair">
  <header class="pair-head">
    <p class="date">{longDate(pair.day)}</p>
    {heading && <h1>{heading}</h1>}
  </header>

  <div class="cards">
    {
      cards.map(({ label, photo }, i) => (
        <>
          {i === 1 && (
            <span class="and" aria-hidden="true">
              &amp;
            </span>
          )}
          <figure class:list={['card', i === 0 ? 'tilt-left' : 'tilt-right']}>
            <p class="label">{label}</p>
            <a href={photo.page_url} rel="noopener" class="frame">
              <img
                src={photo.src_large}
                srcset={`${photo.src_large} 1x, ${photo.src_large2x} 2x`}
                alt={photo.alt}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </a>
            <figcaption>
              Photo by{' '}
              <a href={photo.photographer_url} rel="noopener">
                {photo.photographer}
              </a>{' '}
              on <a href={photo.page_url} rel="noopener">Pexels</a>
            </figcaption>
          </figure>
        </>
      ))
    }
  </div>
</section>

<style>
  .pair-head {
    text-align: center;
    margin: 1.5rem 0 2rem;
  }
  .date {
    margin: 0 0 0.3rem;
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cards {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.25rem;
  }
  .and {
    font-family: var(--display);
    font-style: italic;
    font-size: clamp(3rem, 7vw, 5.5rem);
    color: var(--clay);
    line-height: 1;
  }
  .card {
    margin: 0;
    background: var(--paper);
    border-radius: var(--radius);
    padding: 0.9rem 0.9rem 0.8rem;
    box-shadow:
      0 1px 0 var(--line),
      0 18px 40px -18px rgba(60, 40, 20, 0.35);
    transition: transform 0.25s ease;
  }
  .tilt-left {
    transform: rotate(-1.2deg);
  }
  .tilt-right {
    transform: rotate(1.2deg);
  }
  .card:hover {
    transform: rotate(0deg) translateY(-3px);
  }
  .label {
    margin: 0.1rem 0.2rem 0.7rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--clay);
  }
  .frame {
    display: block;
    border-radius: calc(var(--radius) - 8px);
    overflow: hidden;
    background: var(--line);
    aspect-ratio: 4 / 3;
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  figcaption {
    margin: 0.6rem 0.2rem 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  figcaption a {
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .cards {
      grid-template-columns: 1fr;
    }
    .and {
      text-align: center;
      margin: -0.4rem 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
</style>
